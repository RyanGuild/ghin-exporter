# Copy to .env and fill in. Never commit .env.
# Email or GHIN number both work for email_or_ghin.

GHIN_EMAIL=you@example.com
GHIN_PASSWORD=your-ghin-password

# Optional: force a specific golfer id if login response is ambiguous
# GHIN_ID=1234567

# Optional: polite delay between HTTP requests (seconds)
# GHIN_DELAY=0.75
